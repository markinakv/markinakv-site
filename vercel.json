{
  "redirects": [
    { "source": "/ru", "destination": "/ru/", "statusCode": 308 },
    { "source": "/neurointegration.html", "destination": "/neuro/", "statusCode": 308 },
    { "source": "/ru/neurointegration.html", "destination": "/ru/neuro/", "statusCode": 308 }
  ],
  "rewrites": [
    { "source": "/ru/", "destination": "/index.html" },
    { "source": "/ru/:a/:b/", "destination": "/:a/:b/index.html" },
    { "source": "/ru/:dir/", "destination": "/:dir/index.html" },
    { "source": "/ru/neuro", "destination": "/neuro/index.html" },
    { "source": "/ru/:match*", "destination": "/:match*" }
  ]
}
