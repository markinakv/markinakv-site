{
  "redirects": [
    {
      "source": "/ru",
      "destination": "/ru/",
      "statusCode": 308
    },
    {
      "source": "/growth-operations.html",
      "destination": "/ops/",
      "statusCode": 308
    },
    {
      "source": "/ru/growth-operations.html",
      "destination": "/ru/ops/",
      "statusCode": 308
    },
    {
      "source": "/ru/neuro",
      "destination": "https://mind-hearted.com/",
      "permanent": false
    },
    {
      "source": "/ru/neuro/:path*",
      "destination": "https://mind-hearted.com/:path*",
      "permanent": false
    },
    {
      "source": "/neuro",
      "destination": "https://mind-hearted.com/en/",
      "permanent": false
    },
    {
      "source": "/neuro/:path*",
      "destination": "https://mind-hearted.com/en/:path*",
      "permanent": false
    },
    {
      "source": "/ru/neurointegration.html",
      "destination": "https://mind-hearted.com/",
      "permanent": true
    },
    {
      "source": "/neurointegration.html",
      "destination": "https://mind-hearted.com/en/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ru/",
      "destination": "/index.html"
    },
    {
      "source": "/ru/:a/:b/",
      "destination": "/:a/:b/index.html"
    },
    {
      "source": "/ru/:dir/",
      "destination": "/:dir/index.html"
    },
    {
      "source": "/ru/ops",
      "destination": "/ru/ops/index.html"
    },
    {
      "source": "/ru/cv",
      "destination": "/ru/cv/index.html"
    },
    {
      "source": "/ru/:match*",
      "destination": "/:match*"
    }
  ]
}
